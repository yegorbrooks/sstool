{
  "name": "chargeback-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Branch and version preview links are not covered by Cloudflare Access, so they are switched off.
  "preview_urls": false,
  // If everyone opens the tracker on a custom domain (not the *.workers.dev address),
  // uncomment the next line to switch off the workers.dev address too.
  // "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "chargebacks", "database_id": "7df264e3-3b72-41a2-b571-75224343d154" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "chargeback-files" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://flyluxury.cloudflareaccess.com",
    "POLICY_AUD": "c0ab71c4fa581411f577c84207e5f3d96c1bfea2b35157b09365bbdecd92cbf5",
    "ALLOWED_DOMAIN": "@flyluxury.com"
  }
}
